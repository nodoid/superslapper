<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>32</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SuperSlapper</AssemblyName>
    <RootNamespace>SuperSlapper.Android</RootNamespace>
    <ApplicationId>uk.co.allthejohnsons.superslapper</ApplicationId>
    <ApplicationTitle>SuperSlapper</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <Company>Paul F. Johnson</Company>
    <Product>SuperSlapper</Product>
    <Copyright>© 2026 Paul F. Johnson</Copyright>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuperSlapper.Game\SuperSlapper.Game.csproj">
      <SetTargetFramework>TargetFramework=net10.0-android</SetTargetFramework>
      <!-- The game is plain IL, identical for every ABI, so build it once. The
           per-ABI dispatch otherwise expects an ABI-specific copy that a plain
           build never compiles. -->
      <GlobalPropertiesToRemove>RuntimeIdentifier</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="..\..\Content\**\*.*"
                  Link="Content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
