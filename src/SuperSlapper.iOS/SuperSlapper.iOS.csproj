<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SuperSlapper</AssemblyName>
    <RootNamespace>SuperSlapper.iOS</RootNamespace>
    <ApplicationId>uk.co.allthejohnsons.superslapper</ApplicationId>
    <ApplicationTitle>SuperSlapper</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <Company>Paul F. Johnson</Company>
    <Product>SuperSlapper</Product>
    <Copyright>© 2026 Paul F. Johnson</Copyright>
    <!-- Debug is signed for the phone on the desk: a development certificate and
         the development profile, so the IDE can launch onto a device. Any other
         configuration is a build to hand to Apple, and has to be signed with the
         distribution certificate and the App Store profile instead: a store
         submission signed with a development identity is rejected outright. -->
    <CodesignKey Condition="'$(Configuration)' == 'Debug'">Apple Development: Paul Johnson (WFWPL93CN6)</CodesignKey>
    <CodesignProvision Condition="'$(Configuration)' == 'Debug'">devel-slapper</CodesignProvision>
    <CodesignEntitlements Condition="'$(Configuration)' == 'Debug'">Entitlements.plist</CodesignEntitlements>
    <CodesignKey Condition="'$(Configuration)' != 'Debug'">Apple Distribution: Paul Johnson (3UH7BE38T3)</CodesignKey>
    <CodesignProvision Condition="'$(Configuration)' != 'Debug'">rel-slapper</CodesignProvision>
    <!-- Distribution entitlements carry no get-task-allow: the App Store profile
         forbids it, and a bundle signed with it is refused. -->
    <CodesignEntitlements Condition="'$(Configuration)' != 'Debug'">Entitlements.Distribution.plist</CodesignEntitlements>
    <!-- MonoGame resolves art and audio by name at runtime, so keep trimming off. -->
    <MtouchLink>None</MtouchLink>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <!-- Names the asset-catalog app icon; without it actool builds the catalog
         but produces no icon, and the home screen shows a blank square. -->
    <AppIcon>AppIcon</AppIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuperSlapper.Game\SuperSlapper.Game.csproj">
      <SetTargetFramework>TargetFramework=net10.0-ios</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <BundleResource Include="..\..\Content\**\*.*"
                    Link="Content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- actool only emits icon renditions when it is told which set is the icon. -->
    <ImageAsset Include="Assets.xcassets/**/*.*" />
    <None Include="Entitlements.plist" />
    <None Include="Entitlements.Distribution.plist" />
    <!-- The privacy manifest has to sit at the root of the app bundle, or App
         Store review cannot find it. -->
    <BundleResource Include="PrivacyInfo.xcprivacy" />
  </ItemGroup>

</Project>
