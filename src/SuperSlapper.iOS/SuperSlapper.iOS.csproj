<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SuperSlapper</AssemblyName>
    <RootNamespace>SuperSlapper.iOS</RootNamespace>
    <ApplicationId>uk.co.allthejohnsons.superslapper</ApplicationId>
    <ApplicationTitle>SuperSlapper</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <Company>Paul F. Johnson</Company>
    <Product>SuperSlapper</Product>
    <Copyright>© 2026 Paul F. Johnson</Copyright>
    <CodesignKey>Apple Development: Paul Johnson (WFWPL93CN6)</CodesignKey>
    <CodesignProvision>devel-slapper</CodesignProvision>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <!-- MonoGame resolves art and audio by name at runtime, so keep trimming off. -->
    <MtouchLink>None</MtouchLink>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <!-- Names the asset-catalog app icon; without it actool builds the catalog
         but produces no icon, and the home screen shows a blank square. -->
    <AppIcon>AppIcon</AppIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuperSlapper.Game\SuperSlapper.Game.csproj">
      <SetTargetFramework>TargetFramework=net10.0-ios</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <BundleResource Include="..\..\Content\**\*.*"
                    Link="Content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- actool only emits icon renditions when it is told which set is the icon. -->
    <ImageAsset Include="Assets.xcassets/**/*.*" />
    <None Include="Entitlements.plist" />
    <!-- The privacy manifest has to sit at the root of the app bundle, or App
         Store review cannot find it. -->
    <BundleResource Include="PrivacyInfo.xcprivacy" />
  </ItemGroup>

</Project>
