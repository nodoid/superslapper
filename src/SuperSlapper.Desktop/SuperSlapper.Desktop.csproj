<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">net10.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx'))">net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux'))">net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SuperSlapper</AssemblyName>
    <RootNamespace>SuperSlapper.Desktop</RootNamespace>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>Paul F. Johnson</Company>
    <Product>SuperSlapper</Product>
    <Copyright>© 2026 Paul F. Johnson</Copyright>
    <Version>1.0.0</Version>
    <ApplicationIcon Condition="'$(TargetFramework)' == 'net10.0-windows'">Windows\Icon.ico</ApplicationIcon>
    <ApplicationManifest Condition="'$(TargetFramework)' == 'net10.0-windows'">Windows\app.manifest</ApplicationManifest>
    <UseWindowsForms Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuperSlapper.Game\SuperSlapper.Game.csproj">
      <SetTargetFramework Condition="'$(TargetFramework)' == 'net10.0'">TargetFramework=net10.0</SetTargetFramework>
      <SetTargetFramework Condition="'$(TargetFramework)' == 'net10.0-windows'">TargetFramework=net10.0-windows</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Content\**\*.*"
          Link="Content\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
